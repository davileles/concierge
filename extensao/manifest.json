{
  "manifest_version": 3,
  "name": "Concierge CDV — DS-160",
  "short_name": "DS-160 CDV",
  "version": "1.0.0",
  "description": "Preenche o DS-160 (ceac.state.gov) com as respostas que o cliente enviou pelo formulário do Concierge Estratégico, campo a campo, com revisão.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icones/icone16.png", "32": "icones/icone32.png", "48": "icones/icone48.png", "128": "icones/icone128.png" },
  "action": { "default_title": "Abrir o painel do DS-160", "default_icon": { "16": "icones/icone16.png", "32": "icones/icone32.png" } },
  "side_panel": { "default_path": "painel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "scripting"],
  "host_permissions": [
    "https://ceac.state.gov/*",
    "https://cdv-proxy-production.up.railway.app/*"
  ],
  "content_scripts": [
    { "matches": ["https://ceac.state.gov/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
