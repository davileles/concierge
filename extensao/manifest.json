{
  "manifest_version": 3,
  "name": "Concierge CDV — DS-160 e check-in",
  "short_name": "DS-160 CDV",
  "version": "1.4.0",
  "description": "Preenche o DS-160 com as respostas do cliente e faz sozinho o check-in da Azul dos clientes do Concierge Estratégico.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icones/icone16.png",
    "32": "icones/icone32.png",
    "48": "icones/icone48.png",
    "128": "icones/icone128.png"
  },
  "action": {
    "default_title": "Abrir o painel do DS-160",
    "default_icon": {
      "16": "icones/icone16.png",
      "32": "icones/icone32.png"
    }
  },
  "side_panel": {
    "default_path": "painel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://ceac.state.gov/*",
    "https://cdv-proxy-production.up.railway.app/*",
    "https://www.voeazul.com.br/*",
    "https://baileys-server-production-ebfe.up.railway.app/*",
    "https://concierge.clubedoviajante.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ceac.state.gov/*"
      ],
      "js": [
        "pagina.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://ceac.state.gov/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.voeazul.com.br/*"
      ],
      "js": [
        "checkin-azul.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "opcoes.html"
}
